<Window x:Class="ShopShoe.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShopShoe"
        mc:Ignorable="d"
        Title="OrderEditWindow" Height="500" Width="600" WindowStartupLocation="CenterScreen" Style="{StaticResource WindowStyle}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Name="IdTextBlock" Text="ID заказа:" Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="IdTextBox" Grid.Row="0" Grid.Column="1" Margin="5" IsReadOnly="True" Background="LightGray"/>

        <TextBlock Text="Артикул заказа:" Grid.Row="1" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="ArticleTextBox" Grid.Row="1" Grid.Column="1" Margin="5" MaxLength="6"/>

        <TextBlock Text="Статус заказа:" Grid.Row="2" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <ComboBox x:Name="StatusComboBox" Grid.Row="2" Grid.Column="1" Margin="5" 
                  DisplayMemberPath="Name" SelectedValuePath="Id"/>

        <TextBlock Text="Адрес пункта выдачи:" Grid.Row="3" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <ComboBox x:Name="PickUpPointComboBox" Grid.Row="3" Grid.Column="1" Margin="5" 
                  DisplayMemberPath="FullAddress" SelectedValuePath="Id"/>

        <TextBlock Text="Дата заказа:" Grid.Row="4" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <DatePicker x:Name="OrderDatePicker" Grid.Row="4" Grid.Column="1" Margin="5" 
                    SelectedDateFormat="Short"/>

        <TextBlock Text="Дата доставки:" Grid.Row="5" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <DatePicker x:Name="DeliveryDatePicker" Grid.Row="5" Grid.Column="1" Margin="5" 
                    SelectedDateFormat="Short"/>
        <TextBlock Text="Пользователь:" Grid.Row="6" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <ComboBox x:Name="UserComboBox" Grid.Row="6" Grid.Column="1" Margin="5" 
          DisplayMemberPath="FullName" SelectedValuePath="Id"/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="SaveButton" Content="Сохранить" Width="100" Height="40" Margin="5" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Отмена" Width="100" Height="40" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
