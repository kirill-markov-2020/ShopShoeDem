<Window x:Class="ShopShoe.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShopShoe"
        xmlns:converters="clr-namespace:ShopShoe.Converters"
        mc:Ignorable="d"
        Title="Товары" 
        Height="600" 
        Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75*"/>
            <RowDefinition Height="300*"/>
            <RowDefinition Height="75*"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                
            </Grid.RowDefinitions>
            <TextBlock x:Name="FIO"
                        Text="" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top"
                        Margin="10 10"
                        Grid.Row="0"
                        />
            <TextBlock Text="Товары" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Top"
                       Margin="10 10"
                       Grid.Row="1"
                       />
            <StackPanel Orientation="Horizontal" 
                        Grid.Row="2">
                <ComboBox x:Name="SortingCombobox"
                          SelectedIndex="0"
                          Margin="20 5"
                          Width="200"
                          SelectionChanged="SortingCombobox_SelectionChanged"
                          >
                    <ComboBoxItem Content="По умоланию"/>
                   
                    <ComboBoxItem Content="По убыванию"/>
                    <ComboBoxItem Content="По возрастанию"/>
                </ComboBox>
                <ComboBox x:Name="FilterCombobox"
                          SelectedIndex="0"
                          Margin="20 5"
                          Width="200"
                          SelectionChanged="FilterCombobox_SelectionChanged"
                          >
                </ComboBox>
                <TextBox x:Name="SearchTextBox"
                         TextChanged="SearchTextBox_TextChanged"
                         Margin="20 5"
                         Width="200"
                         Text="">
                    
                </TextBox>
            </StackPanel>
           
        </Grid>
        

        <ListBox x:Name="ProductList" Grid.Row="1" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="10" 
                        BorderBrush="Black" 
                        BorderThickness="2" 
                        
                        Padding="10"
                        Background="{Binding BackgroundColor}"
                        
                        >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="80"
                                    Height="80"
                                    Margin="15 0"
                                    >
                                <Image Source="{Binding Photo, Converter={StaticResource ImagePathConverter}}"
                                       Width="80"
                                       Height="80"
                                       />

                            </Border>

                            <StackPanel Grid.Column="1">
                                <TextBlock>
                                    <Run Text="{Binding Category.Name}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding Name}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Описание товара: "/>
                                    <Run Text="{Binding Description}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Производитель: "/>
                                    <Run Text="{Binding Producer.Name}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Поставщик: "/>
                                    <Run Text="{Binding Supplier.Name}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Цена: "/>
                                    <Run Text="{Binding NewPrice, Mode=OneWay}"/>
                                    <Run Text="{Binding Price}" 
                                         TextDecorations="Strikethrough"
                                         Foreground="Red"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Единица измерения: "/>
                                    <Run Text="{Binding Unit.Name}"/>
                                </TextBlock>
                                <TextBlock>
                                    <Run Text="Количество на складе: "/>
                                    <Run Text="{Binding AmountStock}"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="2">
                                <Run Text="Действующая скидка: "/>
                                <Run Text="{Binding Discount}"/>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="Выйти"
                Margin="10 10"
                HorizontalAlignment="Left" 
                VerticalAlignment="Center"
                Grid.Row="2"
                Click="Button_Click"
                 />

    </Grid>
</Window>
