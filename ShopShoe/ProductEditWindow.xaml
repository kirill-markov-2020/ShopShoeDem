<Window x:Class="ShopShoe.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShopShoe"
        mc:Ignorable="d"
        Title="Редактирование товара" 
        Height="700" 
        Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Style="{StaticResource WindowStyle}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="ID:" Grid.Row="0" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="IdTextBox" Grid.Row="0" Grid.Column="1" Margin="5" IsReadOnly="True" Background="LightGray"/>
        <TextBlock Text="Артикул:" Grid.Row="1" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="ArticleTextBox" Grid.Row="1" Grid.Column="1" Margin="5" MaxLength="6"/>
        <TextBlock Text="Фото:" Grid.Row="2" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="2" Grid.Column="2" Margin="5" Orientation="Horizontal">
            <Button x:Name="SelectPhotoButton" Content="Выбрать фото" Width="100" Click="SelectPhotoButton_Click"/>
            <Image x:Name="PhotoPreview" Width="50" Height="50" Margin="10,0" Stretch="Uniform"/>
        </StackPanel>
        <TextBlock Text="Наименование:" Grid.Row="3" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="NameTextBox" Grid.Row="3" Grid.Column="1" Margin="5"/>
        <TextBlock Text="Категория:" Grid.Row="4" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <ComboBox x:Name="CategoryComboBox" Grid.Row="4" Grid.Column="1" Margin="5" DisplayMemberPath="Name" SelectedValuePath="Id"/>
        <TextBlock Text="Описание:" Grid.Row="5" Grid.Column="0" Margin="5" VerticalAlignment="Top"/>
        <TextBox x:Name="DescriptionTextBox" Grid.Row="5" Grid.Column="1" Margin="5" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
        <TextBlock Text="Производитель:" Grid.Row="6" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <ComboBox x:Name="ProducerComboBox" Grid.Row="6" Grid.Column="1" Margin="5" DisplayMemberPath="Name" SelectedValuePath="Id"/>
        <TextBlock Text="Поставщик:" Grid.Row="7" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <ComboBox x:Name="SupplierComboBox" Grid.Row="7" Grid.Column="1" Margin="5" DisplayMemberPath="Name" SelectedValuePath="Id"/>
        <TextBlock Text="Цена:" Grid.Row="8" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="PriceTextBox" Grid.Row="8" Grid.Column="1" Margin="5"/>
        <TextBlock Text="Единица измерения:" Grid.Row="9" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <ComboBox x:Name="UnitComboBox" Grid.Row="9" Grid.Column="1" Margin="5" DisplayMemberPath="Name" SelectedValuePath="Id"/>
        <TextBlock Text="Количество:" Grid.Row="10" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="AmountTextBox" Grid.Row="10" Grid.Column="1" Margin="5"/>
        <TextBlock Text="Скидка (%):" Grid.Row="11" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
        <TextBox x:Name="DiscountTextBox" Grid.Row="11" Grid.Column="1" Margin="5"/>
        <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button x:Name="SaveButton" Content="Сохранить" Width="100" Height="50" Margin="5" Click="SaveButton_Click"/>
            <Button x:Name="CancelButton" Content="Отмена" Width="100" Height="50" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>